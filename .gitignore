# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
out
release
# OneDrive resolves a sync clash by making "release 2", "release 3"… which the
# bare `release` line doesn't match — and they are ~215MB of build output each.
release [0-9]*
*.local

# impeccable (design skill, scoped to site/ — see .impeccable/config.json, which IS shared).
# The skill itself and its hook now live at global scope (~/.claude), not in this project.
.impeccable/config.local.json
.impeccable/hook.cache.json

# per-machine vault path for dev:legacy
legacy/.env
legacy/.env.*
!legacy/.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# build_centerlines.py keeps the previous centerlines beside the new ones;
# git history already has them, so the copy is local convenience only.
tools/wordmark/*.bak

# Behind-the-scenes promo exports (ProRes masters, frame sequences, webm/webp). Reuben's
# working material for marketing videos, not project files - nothing here ships with the
# app or the site. Regenerate with tools/wordmark/render_promo.py.
# Anchored to the repo root: unanchored, this also matched (and silently untracked)
# src/renderer/src/assets/promo/, the bundled copy StartupSplash.tsx actually ships.
/promo/

# Python bytecode from the wordmark tooling
__pycache__/
*.pyc

# OneDrive writes a "<name>-<machine>" copy when the same file is edited on two
# workstations. They are conflict artefacts, never something to commit.
*-MacBook Air.*
*-MacBook Air
