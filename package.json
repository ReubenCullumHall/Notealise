{
  "name": "notes-app",
  "private": true,
  "version": "0.9.0",
  "description": "A local-first Markdown editor \u2014 your notes stay as plain .md files on disk.",
  "author": "Notealise",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:legacy": "vite legacy",
    "build:legacy": "vite build legacy",
    "serve:legacy": "vite preview legacy --port 5173",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win",
    "package:dir": "electron-vite build && electron-builder --dir",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:mac": "sh tools/sync-mac.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "chokidar": "^4.0.3",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "katex": "^0.18.1",
    "mammoth": "^1.12.0",
    "marked": "^18.0.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
